# =====================================================================
# Proot environment — copy to .env and fill in. Never commit .env.
# =====================================================================

# --- Database (required) ---------------------------------------------
# PostgreSQL 13+ connection string. See DATABASE_SETUP.md.
#   Local:    postgresql://proot:your-password@localhost:5432/proot
#   Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Neon:     postgresql://<user>:<password>@<host>.neon.tech/proot?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/proot
# Set to true for hosted databases that require TLS (Supabase, Neon, RDS, Railway…).
DATABASE_SSL=false

# --- API server --------------------------------------------------------
PORT=4000
# Long random string (at least 32 characters in production): openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated browser origins allowed to call the API. Leave empty in development.
CORS_ORIGINS=
API_BASE_URL=http://localhost:4000/api
WEBUSER_URL=http://localhost:3000

# --- Client apps -------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_WEBUSER_URL=http://localhost:3000
# On a physical phone use your computer's LAN IP, e.g. http://192.168.1.20:4000/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api

# --- Payments: Razorpay (needed for marketplace checkout and care bookings)
# Dashboard → Account & Settings → API Keys (use Test Mode keys while developing).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://<your-api>/api/payments/webhook,
# events payment.captured, order.paid, payment.failed.
RAZORPAY_WEBHOOK_SECRET=

# --- AI meal analysis: Claude (optional; falls back to a built-in estimate)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Housekeeping (optional) ------------------------------------------
APP_TIMEZONE=Asia/Kolkata
PENDING_ORDER_TTL_MIN=30
CHECKIN_TTL_MIN=180
# Sign-in / sign-up attempts allowed per IP per 15 minutes.
AUTH_RATE_LIMIT=20

# --- First admin (optional): applied on startup only while no admin exists
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Your Name
